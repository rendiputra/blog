---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { ArrowRight, BookOpen, Code } from "@lucide/astro";

const allArtikel = (await getCollection("artikel")).sort(
	(a: CollectionEntry<"artikel">, b: CollectionEntry<"artikel">) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTutorial = (await getCollection("tutorial")).sort(
	(a: CollectionEntry<"tutorial">, b: CollectionEntry<"tutorial">) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="TechBlog — Dokumentasi & Tutorial Teknis">
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div
			class="absolute inset-0 bg-gradient-to-b from-sky-500/5 via-transparent to-transparent"
		>
		</div>
		<div class="max-w-6xl mx-auto px-4 py-20 md:py-28 relative">
			<div class="max-w-2xl">
				<div
					class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-400/10 text-sky-400 text-sm font-medium mb-6"
				>
					<Code size={14} />
					<span>Tech Documentation & Blog</span>
				</div>
				<h1
					class="text-4xl md:text-5xl font-bold text-slate-100 tracking-tight leading-tight mb-4"
				>
					Belajar, Membangun,<br />
					<span class="text-sky-400">Berbagi Pengetahuan.</span>
				</h1>
				<p class="text-lg text-slate-400 leading-relaxed mb-8">
					Artikel, tutorial, dan dokumentasi teknis untuk developer.
					Fokus pada performa, keterbacaan, dan kesederhanaan.
				</p>
				<div class="flex flex-wrap gap-3">
					<a
						href="/artikel"
						class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-sky-500 text-slate-900 font-semibold text-sm hover:bg-sky-400 transition-colors"
					>
						Baca Artikel
						<ArrowRight size={16} />
					</a>
					<a
						href="/tutorial"
						class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-slate-700 text-slate-300 font-semibold text-sm hover:bg-slate-800 transition-colors"
					>
						Lihat Tutorial
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Latest Artikel -->
	<section class="max-w-6xl mx-auto px-4 py-12">
		<div class="flex items-center justify-between mb-8">
			<h2
				class="text-2xl font-bold text-slate-100 tracking-tight flex items-center gap-2"
			>
				<BookOpen size={22} class="text-sky-400" />
				Artikel Terbaru
			</h2>
			<a
				href="/artikel"
				class="text-sm text-sky-400 hover:text-sky-300 flex items-center gap-1 transition-colors"
			>
				Semua Artikel <ArrowRight size={14} />
			</a>
		</div>
		<div class="grid md:grid-cols-2 gap-4">
			{
				allArtikel.slice(0, 4).map((post) => (
					<a
						href={`/artikel/${post.slug}`}
						class="group block p-5 rounded-xl border border-slate-800 hover:border-slate-700 bg-slate-800/30 hover:bg-slate-800/50 transition-all"
					>
						<h3 class="text-lg font-semibold text-slate-200 group-hover:text-sky-400 transition-colors mb-2">
							{post.data.title}
						</h3>
						<p class="text-sm text-slate-400 leading-relaxed mb-3">
							{post.data.description}
						</p>
						<time
							class="text-xs text-slate-500"
							datetime={post.data.pubDate.toISOString()}
						>
							{post.data.pubDate.toLocaleDateString("id-ID", {
								year: "numeric",
								month: "short",
								day: "numeric",
							})}
						</time>
					</a>
				))
			}
		</div>
	</section>

	<!-- Latest Tutorial -->
	<section class="max-w-6xl mx-auto px-4 py-12">
		<div class="flex items-center justify-between mb-8">
			<h2
				class="text-2xl font-bold text-slate-100 tracking-tight flex items-center gap-2"
			>
				<Code size={22} class="text-sky-400" />
				Tutorial Terbaru
			</h2>
			<a
				href="/tutorial"
				class="text-sm text-sky-400 hover:text-sky-300 flex items-center gap-1 transition-colors"
			>
				Semua Tutorial <ArrowRight size={14} />
			</a>
		</div>
		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
			{
				allTutorial.slice(0, 3).map((post) => (
					<a
						href={`/tutorial/${post.slug}`}
						class="group block p-5 rounded-xl border border-slate-800 hover:border-slate-700 bg-slate-800/30 hover:bg-slate-800/50 transition-all"
					>
						{post.data.series && (
							<span class="inline-block px-2 py-0.5 rounded-md bg-sky-400/10 text-sky-400 text-xs font-medium mb-2">
								{post.data.series}
							</span>
						)}
						<h3 class="text-lg font-semibold text-slate-200 group-hover:text-sky-400 transition-colors mb-2">
							{post.data.title}
						</h3>
						<p class="text-sm text-slate-400 leading-relaxed">
							{post.data.description}
						</p>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
