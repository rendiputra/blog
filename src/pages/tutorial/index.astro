---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Code } from "@lucide/astro";

const allTutorial = (await getCollection("tutorial")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group tutorials by series
const seriesMap = new Map<string, typeof allTutorial>();
const standaloneTutorials: typeof allTutorial = [];

allTutorial.forEach((t) => {
    if (t.data.series) {
        const existing = seriesMap.get(t.data.series) || [];
        existing.push(t);
        seriesMap.set(t.data.series, existing);
    } else {
        standaloneTutorials.push(t);
    }
});

// Sort series entries by order
seriesMap.forEach((posts, key) => {
    seriesMap.set(
        key,
        posts.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)),
    );
});
---

<BaseLayout
    title="Tutorial — TechBlog"
    description="Tutorial teknis dan panduan step-by-step."
>
    <section class="max-w-6xl mx-auto px-4 py-12">
        <header class="mb-10">
            <h1
                class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-100 tracking-tight flex items-center gap-3 mb-3"
            >
                <Code size={28} class="text-sky-400" />
                Tutorial
            </h1>
            <p class="text-slate-600 dark:text-slate-400 text-lg">
                Panduan teknis step-by-step untuk berbagai teknologi.
            </p>
        </header>

        <!-- Series -->
        {
            Array.from(seriesMap.entries()).map(([seriesName, posts]) => (
                <div class="mb-10">
                    <h2 class="text-xl font-bold text-slate-800 dark:text-slate-200 mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-6 rounded-full bg-sky-400 inline-block" />
                        {seriesName}
                    </h2>
                    <div class="grid gap-3 pl-4 border-l border-slate-200 dark:border-slate-800 transition-colors">
                        {posts.map((post, index) => (
                            <a
                                href={`/tutorial/${post.slug}`}
                                class="group block p-5 rounded-xl border border-slate-200 hover:border-slate-300 bg-slate-50 hover:bg-slate-100 dark:border-slate-800 dark:hover:border-slate-700 dark:bg-slate-800/30 dark:hover:bg-slate-800/50 transition-all"
                            >
                                <div class="flex items-start gap-3">
                                    <span class="flex-shrink-0 w-7 h-7 rounded-full bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-300 text-sm font-medium flex items-center justify-center mt-0.5 transition-colors">
                                        {index + 1}
                                    </span>
                                    <div class="flex-1 min-w-0">
                                        <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 group-hover:text-sky-400 transition-colors mb-1">
                                            {post.data.title}
                                        </h3>
                                        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                                            {post.data.description}
                                        </p>
                                    </div>
                                    <time
                                        class="text-sm text-slate-500 whitespace-nowrap"
                                        datetime={post.data.pubDate.toISOString()}
                                    >
                                        {post.data.pubDate.toLocaleDateString("id-ID", {
                                            day: "numeric",
                                            month: "short",
                                            year: "numeric",
                                        })}
                                    </time>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            ))
        }

        <!-- Standalone Tutorials -->
        {
            standaloneTutorials.length > 0 && (
                <div>
                    <h2 class="text-xl font-bold text-slate-800 dark:text-slate-200 mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-6 rounded-full bg-slate-400 dark:bg-slate-600 inline-block transition-colors" />
                        Tutorial Lainnya
                    </h2>
                    <div class="grid md:grid-cols-2 gap-4">
                        {standaloneTutorials.map((post) => (
                            <a
                                href={`/tutorial/${post.slug}`}
                                class="group block p-5 rounded-xl border border-slate-200 hover:border-slate-300 bg-slate-50 hover:bg-slate-100 dark:border-slate-800 dark:hover:border-slate-700 dark:bg-slate-800/30 dark:hover:bg-slate-800/50 transition-all"
                            >
                                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
                                    <div class="flex-1">
                                        <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 group-hover:text-sky-400 transition-colors mb-2">
                                            {post.data.title}
                                        </h3>
                                        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                                            {post.data.description}
                                        </p>
                                    </div>
                                    <time
                                        class="text-sm text-slate-500 whitespace-nowrap"
                                        datetime={post.data.pubDate.toISOString()}
                                    >
                                        {post.data.pubDate.toLocaleDateString("id-ID", {
                                            day: "numeric",
                                            month: "short",
                                            year: "numeric",
                                        })}
                                    </time>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            )
        }
    </section>
</BaseLayout>
