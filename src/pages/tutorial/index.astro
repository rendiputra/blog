---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Code } from "@lucide/astro";

const allTutorial = (await getCollection("tutorial")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group tutorials by series
const seriesMap = new Map<string, typeof allTutorial>();
const standaloneTutorials: typeof allTutorial = [];

allTutorial.forEach((t) => {
    if (t.data.series) {
        const existing = seriesMap.get(t.data.series) || [];
        existing.push(t);
        seriesMap.set(t.data.series, existing);
    } else {
        standaloneTutorials.push(t);
    }
});

// Sort series entries by order
seriesMap.forEach((posts, key) => {
    seriesMap.set(
        key,
        posts.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)),
    );
});
---

<BaseLayout
    title="Tutorial — TechBlog"
    description="Tutorial teknis dan panduan step-by-step."
>
    <section class="max-w-6xl mx-auto px-4 py-12">
        <header class="mb-10">
            <h1
                class="text-3xl md:text-4xl font-bold text-slate-100 tracking-tight flex items-center gap-3 mb-3"
            >
                <Code size={28} class="text-sky-400" />
                Tutorial
            </h1>
            <p class="text-slate-400 text-lg">
                Panduan teknis step-by-step untuk berbagai teknologi.
            </p>
        </header>

        <!-- Series -->
        {
            Array.from(seriesMap.entries()).map(([seriesName, posts]) => (
                <div class="mb-10">
                    <h2 class="text-xl font-bold text-slate-200 mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-6 rounded-full bg-sky-400 inline-block" />
                        {seriesName}
                    </h2>
                    <div class="grid gap-3 pl-4 border-l border-slate-800">
                        {posts.map((post, index) => (
                            <a
                                href={`/tutorial/${post.slug}`}
                                class="group block p-5 rounded-xl border border-slate-800 hover:border-slate-700 bg-slate-800/30 hover:bg-slate-800/50 transition-all"
                            >
                                <div class="flex items-start gap-3">
                                    <span class="flex-shrink-0 w-7 h-7 rounded-full bg-slate-700 text-slate-300 text-sm font-medium flex items-center justify-center mt-0.5">
                                        {index + 1}
                                    </span>
                                    <div>
                                        <h3 class="text-lg font-semibold text-slate-200 group-hover:text-sky-400 transition-colors mb-1">
                                            {post.data.title}
                                        </h3>
                                        <p class="text-sm text-slate-400 leading-relaxed">
                                            {post.data.description}
                                        </p>
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            ))
        }

        <!-- Standalone Tutorials -->
        {
            standaloneTutorials.length > 0 && (
                <div>
                    <h2 class="text-xl font-bold text-slate-200 mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-6 rounded-full bg-slate-600 inline-block" />
                        Tutorial Lainnya
                    </h2>
                    <div class="grid md:grid-cols-2 gap-4">
                        {standaloneTutorials.map((post) => (
                            <a
                                href={`/tutorial/${post.slug}`}
                                class="group block p-5 rounded-xl border border-slate-800 hover:border-slate-700 bg-slate-800/30 hover:bg-slate-800/50 transition-all"
                            >
                                <h3 class="text-lg font-semibold text-slate-200 group-hover:text-sky-400 transition-colors mb-2">
                                    {post.data.title}
                                </h3>
                                <p class="text-sm text-slate-400 leading-relaxed">
                                    {post.data.description}
                                </p>
                            </a>
                        ))}
                    </div>
                </div>
            )
        }
    </section>
</BaseLayout>
