---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { BookOpen } from "@lucide/astro";

const allArtikel = (await getCollection("artikel")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
    title="Artikel — TechBlog"
    description="Kumpulan artikel teknis dan panduan."
>
    <section class="max-w-6xl mx-auto px-4 py-12">
        <header class="mb-10">
            <h1
                class="text-3xl md:text-4xl font-bold text-slate-100 tracking-tight flex items-center gap-3 mb-3"
            >
                <BookOpen size={28} class="text-sky-400" />
                Artikel
            </h1>
            <p class="text-slate-400 text-lg">
                Artikel teknis, tips, dan panduan untuk developer.
            </p>
        </header>

        <div class="grid gap-4">
            {
                allArtikel.map((post) => (
                    <a
                        href={`/artikel/${post.slug}`}
                        class="group block p-6 rounded-xl border border-slate-800 hover:border-slate-700 bg-slate-800/30 hover:bg-slate-800/50 transition-all"
                    >
                        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
                            <div class="flex-1">
                                <h2 class="text-xl font-semibold text-slate-200 group-hover:text-sky-400 transition-colors mb-2">
                                    {post.data.title}
                                </h2>
                                <p class="text-sm text-slate-400 leading-relaxed mb-3">
                                    {post.data.description}
                                </p>
                                {post.data.tags.length > 0 && (
                                    <div class="flex flex-wrap gap-1.5">
                                        {post.data.tags.map((tag) => (
                                            <span class="px-2 py-0.5 rounded-md bg-slate-800 text-slate-500 text-xs">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>
                            <time
                                class="text-sm text-slate-500 whitespace-nowrap"
                                datetime={post.data.pubDate.toISOString()}
                            >
                                {post.data.pubDate.toLocaleDateString("id-ID", {
                                    year: "numeric",
                                    month: "short",
                                    day: "numeric",
                                })}
                            </time>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>
</BaseLayout>
