---
import { getCollection } from "astro:content";

interface Props {
    currentSlug: string;
    seriesName: string;
}

const { currentSlug, seriesName } = Astro.props;

// Fetch all tutorials in this series, sorted by order
const allTutorials = await getCollection("tutorial");
const seriesPosts = allTutorials
    .filter((t) => t.data.series === seriesName)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

{
    seriesPosts.length > 1 && (
        <nav aria-label="Series navigation">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">
                Seri: {seriesName}
            </h4>
            <ol class="space-y-1 text-sm">
                {seriesPosts.map((post, index) => {
                    const isCurrent = post.slug === currentSlug;
                    return (
                        <li>
                            <a
                                href={`/tutorial/${post.slug}`}
                                class:list={[
                                    "flex items-start gap-2 px-3 py-2 rounded-lg transition-colors",
                                    isCurrent
                                        ? "bg-sky-400/10 text-sky-400 font-medium"
                                        : "text-slate-500 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:bg-slate-800/50",
                                ]}
                                aria-current={isCurrent ? "page" : undefined}
                            >
                                <span
                                    class:list={[
                                        "flex-shrink-0 w-5 h-5 rounded-full text-xs flex items-center justify-center mt-0.5 transition-colors",
                                        isCurrent
                                            ? "bg-sky-400 text-slate-900 font-bold"
                                            : "bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-400",
                                    ]}
                                >
                                    {index + 1}
                                </span>
                                <span class="leading-snug">
                                    {post.data.title}
                                </span>
                            </a>
                        </li>
                    );
                })}
            </ol>
        </nav>
    )
}
