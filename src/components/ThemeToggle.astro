---
import { Sun, Moon } from "@lucide/astro";
---

<button
    id="theme-toggle"
    aria-label="Toggle theme"
    class="p-2 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:bg-slate-800/50 transition-colors"
>
    <span id="theme-icon-sun" class="hidden dark:block">
        <Sun size={20} />
    </span>
    <span id="theme-icon-moon" class="block dark:hidden">
        <Moon size={20} />
    </span>
</button>

<script>
    const toggle = document.getElementById("theme-toggle");

    toggle?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark");

        if (isDark) {
            document.documentElement.classList.remove("dark");
            localStorage.setItem("theme", "light");
        } else {
            document.documentElement.classList.add("dark");
            localStorage.setItem("theme", "dark");
        }
    });
</script>
