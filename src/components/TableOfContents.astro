---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;

// Only show h2 and h3
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
    filteredHeadings.length > 0 && (
        <div id="toc-wrapper">
            <nav aria-label="Table of Contents" data-toc-headings={JSON.stringify(filteredHeadings)}>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">
                    Daftar Isi
                </h4>
                <ul class="space-y-1 text-sm" id="toc-list">
                    {filteredHeadings.map((heading) => (
                        <li data-slug={heading.slug}>
                            <a
                                href={`#${heading.slug}`}
                                data-toc-link={heading.slug}
                                class:list={[
                                    "block py-1.5 px-2 rounded-md transition-all duration-200 border-l-2",
                                    heading.depth === 2
                                        ? "pl-3 text-slate-600 dark:text-slate-400 border-slate-300 dark:border-slate-700 hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-slate-200"
                                        : "pl-6 text-slate-500 dark:text-slate-500 border-slate-200 dark:border-slate-800 hover:bg-slate-100 hover:text-slate-800 dark:hover:bg-slate-800 dark:hover:text-slate-300",
                                ]}
                            >
                                {heading.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
    )
}

<script>
    function initTOC() {
        const nav = document.querySelector("[data-toc-headings]");
        if (!nav) return;

        const headings = JSON.parse(
            nav.dataset.tocHeadings || "[]"
        ) as { slug: string }[];
        const tocLinks = document.querySelectorAll("[data-toc-link]");
        const headingElements = headings
            .map((h) => document.getElementById(h.slug))
            .filter(Boolean) as HTMLElement[];

        if (headingElements.length === 0) return;

        function setActiveLink(slug: string) {
            tocLinks.forEach((link) => {
                const linkSlug = link.getAttribute("data-toc-link");
                const isActive = linkSlug === slug;
                const li = link.closest("li");
                const isH2 = link.classList.contains("pl-3");

                if (isActive) {
                    // Active state: sky background, bold text, sky border
                    link.classList.add(
                        "bg-sky-50", "dark:bg-sky-950/50",
                        "text-sky-600", "dark:text-sky-300",
                        "border-sky-500", "dark:border-sky-500",
                        "font-semibold"
                    );
                    // Remove inactive classes
                    link.classList.remove(
                        "text-slate-600", "text-slate-400",
                        "dark:text-slate-400", "dark:text-slate-500",
                        "text-slate-500",
                        "border-slate-300", "border-slate-700",
                        "border-slate-200", "border-slate-800",
                        "hover:bg-slate-100", "hover:text-slate-900",
                        "dark:hover:bg-slate-800", "dark:hover:text-slate-200",
                        "hover:bg-slate-100", "hover:text-slate-800",
                        "dark:hover:bg-slate-800", "dark:hover:text-slate-300",
                        "font-normal"
                    );
                    li?.classList.add("relative");
                } else {
                    // Inactive state: clean, hoverable
                    link.classList.remove(
                        "bg-sky-50", "dark:bg-sky-950/50",
                        "text-sky-600", "dark:text-sky-300",
                        "border-sky-500", "dark:border-sky-500",
                        "font-semibold"
                    );

                    if (isH2) {
                        link.classList.add(
                            "text-slate-600", "dark:text-slate-400",
                            "border-slate-300", "dark:border-slate-700",
                            "hover:bg-slate-100", "hover:text-slate-900",
                            "dark:hover:bg-slate-800", "dark:hover:text-slate-200"
                        );
                    } else {
                        link.classList.add(
                            "text-slate-500", "dark:text-slate-500",
                            "border-slate-200", "dark:border-slate-800",
                            "hover:bg-slate-100", "hover:text-slate-800",
                            "dark:hover:bg-slate-800", "dark:hover:text-slate-300"
                        );
                    }
                    link.classList.remove("font-normal");
                    li?.classList.remove("relative");
                }
            });
        }

        function onScroll() {
            let currentSlug = "";
            const viewportCenter = window.innerHeight / 2;

            for (const heading of headingElements) {
                const rect = heading.getBoundingClientRect();
                // Trigger when heading top reaches center of viewport
                if (rect.top <= viewportCenter) {
                    currentSlug = heading.id;
                }
            }

            if (!currentSlug && headingElements.length > 0) {
                currentSlug = headingElements[0].id;
            }

            setActiveLink(currentSlug);
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll(); // Initial call
    }

    // Run on DOM ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initTOC);
    } else {
        initTOC();
    }
</script>
