---
import Header from "../components/Header.astro";
import ThemeScript from "../components/ThemeScript.astro";
import SearchModal from "../components/SearchModal.astro";
import BackToTop from "../components/BackToTop.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  pubDate?: Date;
  author?: string;
  tags?: string[];
  canonicalUrl?: string;
}

const {
  title,
  description = "Tech documentation, tutorials, dan artikel.",
  ogImage,
  ogType = "website",
  pubDate,
  author = "TechBlog",
  tags = [],
  canonicalUrl,
} = Astro.props;

const siteUrl = "https://blog.rendiputrapradana.workers.dev";
const siteName = "TechBlog";
const defaultOgImage = `${siteUrl}/og-default.svg`;
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const canonical = canonicalUrl || currentUrl;

// JSON-LD structured data
const isArticle = ogType === "article";
const jsonLd = isArticle
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description: description,
      image: ogImage || defaultOgImage,
      author: {
        "@type": "Person",
        name: author,
        url: siteUrl,
      },
      publisher: {
        "@type": "Organization",
        name: siteName,
        logo: {
          "@type": "ImageObject",
          url: `${siteUrl}/favicon.svg`,
        },
      },
      datePublished: pubDate?.toISOString(),
      dateModified: pubDate?.toISOString(),
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonical,
      },
      keywords: tags.join(", "),
    })
  : JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: siteName,
      url: siteUrl,
      description: description,
      publisher: {
        "@type": "Organization",
        name: siteName,
        logo: {
          "@type": "ImageObject",
          url: `${siteUrl}/favicon.svg`,
        },
      },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${siteUrl}/?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    });
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#0ea5e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />

    <!-- Mobile Web App -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage || defaultOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="id_ID" />
    <meta property="fb:app_id" content="" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || defaultOgImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:site" content="@rendiputra" />
    <meta name="twitter:creator" content="@rendiputra" />

    <!-- Article Specific -->
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {pubDate && <meta property="article:modified_time" content={pubDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={jsonLd} />

    <ThemeScript />

    <style is:global>
      /* Scrollbar styles for TOC */
      .scrollbar-thin::-webkit-scrollbar {
        width: 4px;
        height: 4px;
      }
      .scrollbar-thin::-webkit-scrollbar-track {
        background: transparent;
      }
      .scrollbar-thin::-webkit-scrollbar-thumb {
        background-color: rgb(203 213 225);
        border-radius: 9999px;
      }
      .dark .scrollbar-thin::-webkit-scrollbar-thumb {
        background-color: rgb(71 85 105);
      }
      .scrollbar-thin {
        scrollbar-width: thin;
        scrollbar-color: rgb(203 213 225) transparent;
      }
      .dark .scrollbar-thin {
        scrollbar-color: rgb(71 85 105) transparent;
      }

      /* Table horizontal scroll styles */
      .prose table {
        display: block;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .prose table::-webkit-scrollbar {
        height: 6px;
      }
      .prose table::-webkit-scrollbar-track {
        background: rgb(241 245 249);
        border-radius: 9999px;
      }
      .dark .prose table::-webkit-scrollbar-track {
        background: rgb(30 41 59);
      }
      .prose table::-webkit-scrollbar-thumb {
        background: rgb(203 213 225);
        border-radius: 9999px;
      }
      .dark .prose table::-webkit-scrollbar-thumb {
        background: rgb(71 85 105);
      }

      /* Code block horizontal scroll - preserves ASCII art */
      .prose pre {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        white-space: pre;
      }
      .prose pre code {
        display: block;
        white-space: pre;
        font-family: 'JetBrains Mono', monospace;
      }
      .prose pre::-webkit-scrollbar {
        height: 6px;
      }
      .prose pre::-webkit-scrollbar-track {
        background: rgb(241 245 249);
        border-radius: 9999px;
      }
      .dark .prose pre::-webkit-scrollbar-track {
        background: rgb(30 41 59);
      }
      .prose pre::-webkit-scrollbar-thumb {
        background: rgb(203 213 225);
        border-radius: 9999px;
      }
      .dark .prose pre::-webkit-scrollbar-thumb {
        background: rgb(71 85 105);
      }
    </style>
  </head>
  <body
    class="bg-white text-slate-700 dark:bg-slate-900 dark:text-slate-300 font-sans min-h-screen antialiased transition-colors duration-300"
  >
    <Header />
    <main>
      <slot />
    </main>
    <footer
      class="border-t border-slate-200 dark:border-slate-800 py-8 mt-16 transition-colors"
    >
      <div class="max-w-6xl mx-auto px-4 text-center text-sm text-slate-500">
        <p>&copy; {new Date().getFullYear()} TechBlog. Built with Astro.</p>
      </div>
    </footer>
    <SearchModal />
    <BackToTop />
  </body>
</html>
