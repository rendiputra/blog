---
import Header from "../components/Header.astro";
import ThemeScript from "../components/ThemeScript.astro";
import SearchModal from "../components/SearchModal.astro";
import BackToTop from "../components/BackToTop.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  pubDate?: Date;
}

const {
  title,
  description = "Tech documentation, tutorials, dan artikel.",
  ogImage,
  ogType = "website",
  pubDate,
} = Astro.props;

const siteUrl = "https://blog.rendiputrapradana.workers.dev";
const siteName = "TechBlog";
const defaultOgImage = `${siteUrl}/og-default.svg`;
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage || defaultOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || defaultOgImage} />

    <!-- Article specific -->
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <ThemeScript />
    <style is:global>
      /* Scrollbar styles for TOC */
      .scrollbar-thin::-webkit-scrollbar {
        width: 4px;
        height: 4px;
      }
      .scrollbar-thin::-webkit-scrollbar-track {
        background: transparent;
      }
      .scrollbar-thin::-webkit-scrollbar-thumb {
        background-color: rgb(203 213 225);
        border-radius: 9999px;
      }
      .dark .scrollbar-thin::-webkit-scrollbar-thumb {
        background-color: rgb(71 85 105);
      }
      .scrollbar-thin {
        scrollbar-width: thin;
        scrollbar-color: rgb(203 213 225) transparent;
      }
      .dark .scrollbar-thin {
        scrollbar-color: rgb(71 85 105) transparent;
      }

      /* Table horizontal scroll styles */
      .prose table {
        display: block;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .prose table::-webkit-scrollbar {
        height: 6px;
      }
      .prose table::-webkit-scrollbar-track {
        background: rgb(241 245 249);
        border-radius: 9999px;
      }
      .dark .prose table::-webkit-scrollbar-track {
        background: rgb(30 41 59);
      }
      .prose table::-webkit-scrollbar-thumb {
        background: rgb(203 213 225);
        border-radius: 9999px;
      }
      .dark .prose table::-webkit-scrollbar-thumb {
        background: rgb(71 85 105);
      }

      /* Code block horizontal scroll - preserves ASCII art */
      .prose pre {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        white-space: pre;
      }
      .prose pre code {
        display: block;
        white-space: pre;
        font-family: 'JetBrains Mono', monospace;
      }
      .prose pre::-webkit-scrollbar {
        height: 6px;
      }
      .prose pre::-webkit-scrollbar-track {
        background: rgb(241 245 249);
        border-radius: 9999px;
      }
      .dark .prose pre::-webkit-scrollbar-track {
        background: rgb(30 41 59);
      }
      .prose pre::-webkit-scrollbar-thumb {
        background: rgb(203 213 225);
        border-radius: 9999px;
      }
      .dark .prose pre::-webkit-scrollbar-thumb {
        background: rgb(71 85 105);
      }
    </style>
  </head>
  <body
    class="bg-white text-slate-700 dark:bg-slate-900 dark:text-slate-300 font-sans min-h-screen antialiased transition-colors duration-300"
  >
    <Header />
    <main>
      <slot />
    </main>
    <footer
      class="border-t border-slate-200 dark:border-slate-800 py-8 mt-16 transition-colors"
    >
      <div class="max-w-6xl mx-auto px-4 text-center text-sm text-slate-500">
        <p>&copy; {new Date().getFullYear()} TechBlog. Built with Astro.</p>
      </div>
    </footer>
    <SearchModal />
    <BackToTop />
  </body>
</html>
